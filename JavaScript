// POST /generate
// Body: { "prompt": "Write a short description", "model": "gpt2", "max_tokens": 150 }
app.post('/generate', async (req, res) => {
  const prompt = (req.body?.prompt || '').trim();
  if (!prompt) return res.status(400).json({ error: 'prompt is required' });

  // Prefer Hugging Face Inference API (free tier). Provide HF_API_TOKEN as a secret.
  const HF_TOKEN = process.env.HF_API_TOKEN;
  const model = req.body.model || process.env.HF_DEFAULT_MODEL || 'gpt2';
  const max_tokens = Number(req.body.max_tokens || 150);

  if (!HF_TOKEN) {
    return res.status(400).json({ error: 'HF_API_TOKEN not set. Add it as a secret to use /generate.' });
  }

  try {
    const resp = await fetch(`https://api-inference.huggingface.co/models/${model}`, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${HF_TOKEN}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        inputs: prompt,
        parameters: { max_new_tokens: max_tokens }
      })
    });

    if (!resp.ok) {
      const txt = await resp.text();
      return res.status(resp.status).json({ error: 'HF inference error', detail: txt });
    }

    const data = await resp.json();
    // HF Inference returns various shapes depending on the model; common: [{ generated_text: "..." }]
    let text = null;
    if (Array.isArray(data) && data[0]?.generated_text) text = data[0].generated_text;
    else if (data?.generated_text) text = data.generated_text;
    else text = JSON.stringify(data).slice(0, 2000);

    return res.json({ model, generated: text, raw: data });
  } catch (err) {
    console.error('HF error', err);
    return res.status(500).json({ error: 'inference failed', details: err?.message || err });
  }
});
